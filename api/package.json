{
  "name": "@elloria/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "imports": {
    "#app/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "build": "pnpm run codegen && pnpm run build:ts",
    "start": "node dist/server.js",
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "codegen": "openapi-ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:knip": "knip --tsConfig tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run codegen && pnpm run lint && pnpm run lint:knip && pnpm run typecheck && pnpm run test && pnpm run build:ts",
    "db:generate": "node --conditions=development node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=development --import tsx src/commands/migrate.ts",
    "db:migrate:prod": "node dist/commands/migrate.js",
    "db:studio": "node --conditions=development node_modules/drizzle-kit/bin.cjs studio",
    "build:ts": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "knip": "6.44.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
