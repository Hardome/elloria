{
  "name": "@elloria/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=12.6.0"
  },
  "imports": {
    "#app/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "build": "pnpm run codegen && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "codegen": "openapi-ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "spellcheck": "cspell --config cspell.config.yaml",
    "lint:knip": "knip --tsConfig tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run codegen && pnpm run lint && pnpm run spellcheck && pnpm run lint:knip && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:generate": "node --conditions=development node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=development --import tsx src/commands/migrate.ts",
    "db:migrate:prod": "node dist/commands/migrate.js",
    "db:studio": "node --conditions=development node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cspell/dict-ru_ru": "2.3.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "cspell": "10.4.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.42.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
