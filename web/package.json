{
  "name": "@elloria/web",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write --no-errors-on-unmatched .",
    "lint": "pnpm run lint:biome && pnpm run lint:eslint",
    "lint:biome": "biome check --no-errors-on-unmatched .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:fix": "biome check --write --no-errors-on-unmatched . && eslint . --fix --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "Firefox ESR"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "cn": "0.5.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.4.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  }
}
